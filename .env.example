FLASK_APP=run.py
FLASK_ENV=development
SECRET_KEY=change-me-to-a-random-secret
DATABASE_URL=sqlite:///retail.db
AZURE_SQL_URL=mssql+pyodbc://username:password@server.database.windows.net/dbname?driver=ODBC+Driver+18+for+SQL+Server
OPENAI_API_KEY=your_openai_api_key

# AI Mode (mock | azure)
AI_MODE=mock

# Power BI Embed URL (Optional)
POWER_BI_URL=

# Azure OpenAI (Required for 'azure' mode)
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=

# Azure Cognitive Search (RAG)
AZURE_SEARCH_ENDPOINT=
AZURE_SEARCH_KEY=
AZURE_SEARCH_INDEX=
